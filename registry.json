      "description": "Neutral light and dark tokens for Tailwind v4 and shadcn/ui.",
      "dependencies": [
        "shadcn@^4.21.4",
        "tw-animate-css@^1.4.0"
      ],
      "cssVars": {
        "theme": {
          "font-heading": "var(--font-sans)",
