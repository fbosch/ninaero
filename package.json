{
  "name": "ninaero",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm registry:build && next build",
    "start": "next start",
    "registry:build": "node scripts/build-registry.mjs && shadcn build",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test components/examples/__tests__/*.test.mjs components/home-background/__tests__/*.test.mjs lib/__tests__/*.test.mjs registry/ninaero/__tests__/*.test.mjs scripts/lib/__tests__/*.test.mjs",
    "check:shadcn": "node scripts/check-shadcn.mjs",
    "check:shadcn:release": "node scripts/check-shadcn.mjs --release",
    "check": "pnpm build && pnpm check:shadcn && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/google-sans-flex": "5.3.2",
    "@iconify-icons/mage": "^2.0.0",
    "@iconify/react": "^6.0.2",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.14.4",
    "recharts": "3.8.0",
    "shadcn": "^4.21.4",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "lefthook": "^2.2.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.20.0"
}
